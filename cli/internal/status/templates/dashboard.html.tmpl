<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>steer status</title>
<style>
:root {
  color-scheme: light dark;
  --bg: #0d1017; --panel: #141821; --panel-2: #191e29; --line: #262d3a;
  --text: #e6e9ef; --dim: #99a1b3; --faint: #6b7385;
  --brand: #a78bfa; --ok: #10b981; --warn: #f59e0b; --bad: #ef4444; --info: #06b6d4;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: light) {
  :root {
    --bg: #f6f7f9; --panel: #ffffff; --panel-2: #f2f4f7; --line: #e0e4ea;
    --text: #171a21; --dim: #59606f; --faint: #868d9c; --brand: #7c5cf0;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
}
.wrap { max-width: 1180px; margin: 0 auto; padding: 32px 24px 72px; }

/* header */
.masthead { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin-bottom: 6px; }
.mark { font-family: var(--mono); font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
.mark span { color: var(--brand); }
.tagline { color: var(--dim); font-size: 13px; }
.stamp { margin-left: auto; font-family: var(--mono); font-size: 12px; color: var(--faint); }

.posture { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 30px; }
.chip {
  display: inline-flex; align-items: baseline; gap: 7px;
  background: var(--panel); border: 1px solid var(--line); border-radius: 7px;
  padding: 7px 11px; font-size: 12px;
}
.chip b { font-weight: 600; color: var(--dim); text-transform: uppercase; letter-spacing: 0.06em; font-size: 10.5px; }
.chip .v { font-family: var(--mono); }
.dot { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); align-self: center; }
.dot.armed { background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent); }
.dot.inert { background: var(--warn); }
.dot.off { background: var(--faint); }

/* section frame */
section { margin-bottom: 30px; }
h2 {
  font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--faint); margin: 0 0 12px;
}
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 11px; }

/* stepper */
.stepper { display: flex; align-items: stretch; overflow-x: auto; }
.step { flex: 1; min-width: 150px; padding: 18px 18px 16px; position: relative; }
.step + .step { border-left: 1px solid var(--line); }
.step .n { font-family: var(--mono); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
.step .name { font-size: 12.5px; font-weight: 600; margin-top: 2px; }
.step .note { font-size: 11.5px; color: var(--faint); margin-top: 3px; }
.step.done .n { color: var(--brand); }
.step:not(.done) .n, .step:not(.done) .name { color: var(--faint); }

/* attention */
.attn { border-color: color-mix(in srgb, var(--warn) 45%, var(--line)); }
.attn .band { padding: 10px 16px; border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--warn) 10%, transparent); font-weight: 600; font-size: 13px; }
.attn.quiet { border-color: color-mix(in srgb, var(--ok) 45%, var(--line)); }
.attn.quiet .band { background: color-mix(in srgb, var(--ok) 10%, transparent); }
.attn ul { list-style: none; margin: 0; padding: 6px 0; }
.attn li { padding: 9px 16px; display: flex; flex-wrap: wrap; gap: 10px; align-items: baseline; }
.attn li + li { border-top: 1px solid var(--line); }
.attn .cls { font-family: var(--mono); font-weight: 600; }
.attn .sub { color: var(--dim); font-size: 12.5px; }
.attn .right { margin-left: auto; font-family: var(--mono); font-size: 12px; color: var(--dim); }

/* cards */
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
.card { padding: 15px 16px; }
.card .label { font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--faint); }
.card .value { font-family: var(--mono); font-size: 27px; font-weight: 600; letter-spacing: -0.02em; margin: 5px 0 4px; }
.card .meta { font-size: 11.5px; color: var(--dim); }

/* tables */
table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
thead th {
  text-align: left; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--faint); font-weight: 600; padding: 11px 14px; border-bottom: 1px solid var(--line);
  white-space: nowrap;
}
tbody td { padding: 11px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: var(--panel-2); }
.mono { font-family: var(--mono); }
.num { font-family: var(--mono); text-align: right; white-space: nowrap; }
.dimtext { color: var(--dim); }
.d-down { color: var(--ok); }
.d-up { color: var(--bad); }
.scroll { overflow-x: auto; }
.empty { padding: 16px; color: var(--faint); font-size: 12.5px; }

/* pills */
.pill {
  display: inline-block; padding: 2px 9px; border-radius: 999px;
  font-size: 11px; font-weight: 600; font-family: var(--mono); white-space: nowrap;
  border: 1px solid var(--line); color: var(--dim);
}
.v-effective, .v-class-faded { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 50%, transparent);
  background: color-mix(in srgb, var(--ok) 12%, transparent); }
.v-collecting, .v-inconclusive, .v-class-inconclusive, .v-no-baseline {
  color: var(--info); border-color: color-mix(in srgb, var(--info) 50%, transparent);
  background: color-mix(in srgb, var(--info) 12%, transparent); }
.v-ineffective, .v-class-grew, .v-harmful, .v-not-triggered { color: var(--bad); border-color: color-mix(in srgb, var(--bad) 50%, transparent);
  background: color-mix(in srgb, var(--bad) 12%, transparent); }
.v-class-steady, .v-confounded, .v-evidence-incomplete, .v-legacy-unscoped, .v-unattributed {
  color: var(--warn); border-color: color-mix(in srgb, var(--warn) 50%, transparent);
  background: color-mix(in srgb, var(--warn) 12%, transparent); }
.tier { display: inline-block; padding: 1px 8px; border-radius: 5px; font-family: var(--mono);
  font-size: 11px; border: 1px solid var(--line); background: var(--panel-2); color: var(--dim); }

.split { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
.kv { padding: 15px 16px; }
.kv h3 { font-size: 12px; margin: 0 0 10px; font-weight: 600; }
.kv dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; font-size: 12.5px; }
.kv dt { color: var(--faint); }
.kv dd { margin: 0; font-family: var(--mono); word-break: break-all; }
footer { color: var(--faint); font-size: 11.5px; border-top: 1px solid var(--line); padding-top: 14px; }
</style>
</head>
<body>
<div class="wrap">

<div class="masthead">
  <div class="mark">steer<span>·</span>status</div>
  <div class="tagline">evidence → review → intervention → measurement</div>
  <div class="stamp">{{ .Generated }}</div>
</div>

<div class="posture">
  <div class="chip"><b>instrument</b><span class="v">{{ .Status.Posture.Instrument }}</span></div>
  <div class="chip"><b>reviewer</b><span class="v">{{ .Status.Posture.Reviewer }}</span></div>
  {{- range .Status.Posture.CommitGate }}
  <div class="chip"><span class="dot {{ arming . }}"></span><b>gate {{ .Harness }} {{ .Scope }}</b><span class="v">{{ arming . }}{{ if .Timeout }} · {{ .Timeout }}s{{ end }}{{ if .Registered }}{{ with trust .Trust }} · {{ . }}{{ end }}{{ with observed . }} · {{ . }}{{ end }}{{ with resolves . }} · {{ . }}{{ end }}{{ end }}</span></div>
  {{- end }}
  {{- range .Status.Posture.Denials }}
  <div class="chip"><span class="dot {{ arming . }}"></span><b>denials {{ .Harness }} {{ .Scope }}</b><span class="v">{{ arming . }}{{ if .Registered }}{{ with observed . }} · {{ . }}{{ end }}{{ with resolves . }} · {{ . }}{{ end }}{{ end }}</span></div>
  {{- end }}
  {{- range .Status.Posture.Resolver }}
  <div class="chip"><span class="dot {{ arming . }}"></span><b>resolver {{ .Harness }} {{ .Scope }}</b><span class="v">{{ arming . }}{{ if .Registered }}{{ with trust .Trust }} · {{ . }}{{ end }}{{ with resolves . }} · {{ . }}{{ end }}{{ end }}</span></div>
  {{- end }}
  {{- range .Status.Posture.Masters }}
  {{- $m := . }}
  {{- with master . }}
  <div class="chip"><b>guard master {{ $m.Harness }} {{ $m.Scope }}</b><span class="v">{{ . }}{{ with mobserved $m }} · {{ . }}{{ end }}</span></div>
  {{- end }}
  {{- end }}
  {{- if .Status.Posture.Unresolved }}
  <div class="chip"><b>unresolved</b><span class="v">{{ .Status.Posture.Unresolved }} row(s) owe a ledger</span></div>
  {{- end }}
  <div class="chip"><b>corpora</b><span class="v">{{ present .Status.Corpora }} of {{ len .Status.Corpora }} present</span></div>
</div>

<section>
  <h2>Loop</h2>
  <div class="panel stepper">
    {{- range .Stages }}
    <div class="step{{ if .Done }} done{{ end }}">
      <div class="n">{{ .Count }}</div>
      <div class="name">{{ .Name }}</div>
      <div class="note">{{ .Note }}</div>
    </div>
    {{- end }}
  </div>
</section>

<section>
  <h2>Attention required</h2>
  <div class="panel attn{{ if .Quiet }} quiet{{ end }}">
    {{- if .Quiet }}
    <div class="band">Nothing pending — the loop is quiet.</div>
    {{- else }}
    <div class="band">Work the deterministic tier flagged</div>
    {{- range .Attention }}
    <div class="band">{{ .Key }}</div>
    <ul>
      {{- range .Items }}
      <li>
        <span class="pill v-{{ slug .Verdict }}">{{ .Verdict }}</span>
        <span class="cls">{{ .Class }}</span>
        <span class="sub">{{ .Tier }} → {{ .Target }}</span>
        <div class="sub">{{ recur .Before .After .Unit }}</div>
        <div class="sub">{{ action .Verdict (unmeas .Verdict .Unit .RequiredAfter) }}</div>
        {{- with claim .Verdict .Effect }}<div class="sub mono">{{ . }}</div>{{ end }}
        {{- if .RequiredAfter }}{{- with wait .RequiredAfter .Unit }}<div class="sub">{{ . }}</div>{{ end }}{{ else }}{{- with needs .RequiredAfter .Verdict }}<div class="sub">{{ . }}</div>{{ end }}{{ end }}
        <div class="sub">scope {{ scope .Scope }} · before {{ cover .BeforeCoverage }} · after {{ cover .AfterCoverage }}</div>
        {{- if or (unmeas .Verdict .Unit .RequiredAfter) (eq .Verdict "harmful") }}<div class="sub">{{ removal .Tier .Target }}</div>{{ end }}
        {{- with attrib .Attribution }}<div class="sub">{{ . }}</div>{{ end }}
        {{- range reasons "confound" .Confounds }}<div class="sub">{{ . }}</div>{{ end }}
        {{- range reasons "composition" .Composition }}<div class="sub">{{ . }}</div>{{ end }}
      </li>
      {{- end }}
    </ul>
    {{- end }}
    {{- if .Status.Attention.Candidates }}
    <ul>
      {{- range .Status.Attention.Candidates }}
      <li>
        <span class="pill">candidate</span>
        <span class="cls">{{ if .Pattern }}{{ .Pattern }}{{ else }}{{ .Corpus }}{{ end }}</span>
        <span class="sub">
          {{- if .Pattern }}{{ .Count }} hits across {{ .Sessions }} sessions · {{ .Corpus }}
          {{- else }}{{ .UndecidedChains }} undecided chains · {{ .Dump }}{{ end }}</span>
        <span class="right">pending routing</span>
      </li>
      {{- end }}
    </ul>
    {{- end }}
    {{- if .Status.Attention.Unscored }}
    <ul>
      <li>
        <span class="pill">unscored</span>
        <span class="sub">{{ len .Status.Attention.Unscored }} intervention(s) from a corpus no engine reads</span>
        <span class="right mono">{{ range .Status.Attention.Unscored }}{{ . }} {{ end }}</span>
      </li>
    </ul>
    {{- end }}
    {{- end }}
  </div>
</section>

<section>
  <h2>Measurement</h2>
  <div class="cards">
    {{- range .Cards }}
    <div class="panel card">
      <div class="label">{{ .Label }}</div>
      <div class="value">{{ .Value }}</div>
      <div class="meta">{{ .Meta }}</div>
    </div>
    {{- end }}
  </div>
</section>

<section>
  <h2>Failure-class ledger</h2>
  <div class="panel scroll">
    {{- if .Ledger }}
    <table>
      <thead><tr>
        <th>Class</th><th>Tier → target</th><th>Status</th>
        <th class="num">Baseline</th><th class="num">Post-install</th><th class="num">Δ rate</th>
        <th>Effect range</th><th>Verdict</th>
      </tr></thead>
      <tbody>
      {{- range .Ledger }}
        <tr>
          <td>
            <span class="mono">{{ .Class }}</span>
            {{- if .Match }}<div class="dimtext mono">/{{ .Match }}/</div>{{ end }}
            {{- if .HookID }}<div class="dimtext mono">{{ .HookID }}</div>{{ end }}
          </td>
          <td><span class="tier">{{ .Tier }}</span> <span class="dimtext mono">{{ .Target }}</span></td>
          <td class="dimtext">{{ .Status }}</td>
          <td class="num">{{ .Before.Hits }}/{{ .Before.Units }}<div class="dimtext">{{ pctIf .Verdict .Before }}</div></td>
          <td class="num">{{ .After.Hits }}/{{ .After.Units }}<div class="dimtext">{{ pctIf .Verdict .After }}</div></td>
          <td class="num">{{ deltaIf .Verdict .Before .After }}</td>
          <td>
            <div>{{ action .Verdict (unmeas .Verdict .Unit .RequiredAfter) }}</div>
            {{- with claim .Verdict .Effect }}<div class="mono">{{ . }}</div>{{ end }}
            {{- if .RequiredAfter }}{{- with wait .RequiredAfter .Unit }}<div class="dimtext">{{ . }}</div>{{ end }}{{ else }}{{- with needs .RequiredAfter .Verdict }}<div class="dimtext">{{ . }}</div>{{ end }}{{ end }}
            <div class="dimtext">scope {{ scope .Scope }}</div>
            <div class="dimtext">before {{ cover .BeforeCoverage }} · after {{ cover .AfterCoverage }}</div>
            {{- with attrib .Attribution }}<div class="dimtext">{{ . }}</div>{{ end }}
            {{- range reasons "confound" .Confounds }}<div class="dimtext">{{ . }}</div>{{ end }}
            {{- range reasons "composition" .Composition }}<div class="dimtext">{{ . }}</div>{{ end }}
          </td>
          <td>
            <span class="pill v-{{ slug .Verdict }}">{{ .Verdict }}</span>
            {{- if .InstrumentDrift }}<div class="dimtext">⚠ instrument drift</div>{{ end }}
            {{- if .PValue }}<div class="dimtext">p={{ printf "%.3f" .PValue }}</div>{{ end }}
            {{- if eq .Status "rejected" }}
              {{- if .Reason }}<div class="dimtext">{{ .Reason }}</div>{{ end }}
              {{- if .Reopen }}<div class="dimtext">reopen if: {{ .Reopen }}</div>{{ end }}
            {{- end }}
          </td>
        </tr>
      {{- end }}
      </tbody>
    </table>
    {{- else }}
    <div class="empty">No interventions recorded on this machine.</div>
    {{- end }}
  </div>
</section>

<section>
  <h2>Active interventions by tier</h2>
  <div class="panel scroll">
    {{- if .Tiers }}
    <table>
      <thead><tr><th>Tier</th><th>Target</th><th>Class</th><th>Hook</th><th>Verdict</th></tr></thead>
      <tbody>
      {{- range .Tiers }}
        {{- $tier := .Key }}
        {{- range .Items }}
        <tr>
          <td><span class="tier">{{ $tier }}</span></td>
          <td class="mono">{{ .Target }}</td>
          <td class="mono">{{ .Class }}</td>
          <td class="mono dimtext">{{ if .HookID }}{{ .HookID }}{{ else }}—{{ end }}</td>
          <td><span class="pill v-{{ slug .Verdict }}">{{ .Verdict }}</span></td>
        </tr>
        {{- end }}
      {{- end }}
      </tbody>
    </table>
    {{- else }}
    <div class="empty">No active interventions installed.</div>
    {{- end }}
  </div>
</section>

<section>
  <h2>Recent review chains</h2>
  <div class="panel scroll">
    {{- if .Status.Chains }}
    <table>
      <thead><tr>
        <th>Started</th><th>Host</th><th class="num">Rounds</th><th class="num">Files</th>
        <th class="num">Findings</th><th class="num">Accepted</th><th class="num">Rejected</th><th>Terminal</th>
      </tr></thead>
      <tbody>
      {{- range .Status.Chains }}
        <tr>
          <td class="mono">{{ stamp .StartTS }}</td>
          <td class="mono dimtext">{{ .Host }}</td>
          <td class="num">{{ .Rounds }}</td>
          <td class="num">{{ .Files }}</td>
          <td class="num">{{ .Findings }}</td>
          <td class="num">{{ .Accepted }}</td>
          <td class="num">{{ .Rejected }}</td>
          <td class="mono dimtext">{{ if .Terminal }}{{ .Terminal }}{{ else }}—{{ end }}</td>
        </tr>
      {{- end }}
      </tbody>
    </table>
    {{- else }}
    <div class="empty">No adjudicated chains on this machine.</div>
    {{- end }}
  </div>
</section>

<section>
  <h2>System health</h2>
  <div class="split">
    <div class="panel kv">
      <h3>Evidence corpora</h3>
      <dl>
      {{- range .Status.Corpora }}
        <dt>{{ .Corpus }}</dt>
        <dd>{{ if .Present }}{{ .Size }} rows{{ else }}absent{{ end }}{{ if .Path }}<div class="dimtext mono">{{ .Path }}</div>{{ end }}</dd>
      {{- end }}
      </dl>
    </div>
    <div class="panel kv">
      <h3>Instrument</h3>
      <dl>
        <dt>ledger</dt><dd>{{ .Status.Posture.Ledger }}</dd>
        <dt>reviewer</dt><dd>{{ .Status.Posture.Reviewer }}</dd>
        <dt>instrument</dt><dd>{{ .Status.Posture.Instrument }}</dd>
        <dt>schema</dt><dd>status_version {{ .Status.StatusVersion }}</dd>
      </dl>
    </div>
  </div>
</section>

<footer>
  Rendered by <span class="mono">steer status --html</span> from one read-only snapshot. Counts are machine-local and partial.
</footer>

</div>
</body>
</html>
