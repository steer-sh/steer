{
  "version": 1,
  "hook": "no-direct-main-hook",
  "cases": [
    {
      "name": "bare push on main is blocked",
      "payload": {
        "tool_input": {
          "command": "git push"
        },
        "tool_name": "Bash"
      },
      "expect": "block",
      "files": {
        ".git/HEAD": "ref: refs/heads/main\n",
        ".git/config": "[remote \"origin\"]\n\turl = git@github.com:steer-sh/steer.git\n"
      },
      "origin": "synthetic"
    },
    {
      "name": "cd into another repository on main is allowed",
      "payload": {
        "tool_input": {
          "command": "cd sub \u0026\u0026 git commit -m x"
        },
        "tool_name": "Bash"
      },
      "expect": "allow",
      "files": {
        ".git/HEAD": "ref: refs/heads/feat\n",
        ".git/config": "[remote \"origin\"]\n\turl = git@github.com:steer-sh/steer.git\n",
        "sub/.git/HEAD": "ref: refs/heads/main\n",
        "sub/.git/config": "[remote \"origin\"]\n\turl = git@github.com:example/notes.git\n"
      },
      "origin": "synthetic"
    },
    {
      "name": "checkout -b then commit is allowed",
      "payload": {
        "tool_input": {
          "command": "git checkout -b fix/a \u0026\u0026 git commit -m x"
        },
        "tool_name": "Bash"
      },
      "expect": "allow",
      "files": {
        ".git/HEAD": "ref: refs/heads/main\n",
        ".git/config": "[remote \"origin\"]\n\turl = git@github.com:steer-sh/steer.git\n"
      },
      "origin": "synthetic"
    },
